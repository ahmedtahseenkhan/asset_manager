# IT Asset Manager — API image
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# ping + arp for the network-scan connector (the slim image ships neither)
RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping net-tools \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first for layer caching
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Application code (the vendor license-signer tool is NOT copied — customer
# installations must never contain the private signing key or tooling)
COPY backend /app/backend
# Agent scripts, served to endpoints by /api/agents/download/*
COPY agent /app/agent

# Non-root runtime user
RUN useradd --create-home --uid 10001 itam \
    && mkdir -p /data && chown itam:itam /data
USER itam

# The license file lives on a volume so it survives image upgrades.
# Set LICENSE_FILE=/data/license.lic in the environment.
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; \
      sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status==200 else 1)"

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
